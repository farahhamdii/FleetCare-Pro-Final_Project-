@{
    ViewData["Title"] = "FleetCare Pro";
}

<div class="landing-page">

    <!-- ========================= HERO ========================= -->

    <section class="hero-section">

        <div class="container">

            <div class="row align-items-center min-vh-75">

                <!-- Hero Content -->

                <div class="col-lg-6">

                    <span class="hero-badge">
                        <i class="bi bi-shield-check"></i>
                        Smart Fleet Management
                    </span>

                    <h1 class="hero-title">
                        Keep Your Fleet
                        <span>Running Smarter.</span>
                    </h1>

                    <p class="hero-text">
                        FleetCare Pro helps you manage vehicles, maintenance
                        records, service centers, and fleet operations
                        from one powerful platform.
                    </p>

                    <div class="hero-actions">

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-primary btn-lg hero-btn">
                            Get Started
                            <i class="bi bi-arrow-right"></i>
                        </a>

                        <a href="#features"
                           class="btn btn-outline-dark btn-lg hero-secondary-btn">
                            Explore Features
                        </a>

                    </div>

                    <div class="hero-trust">

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Secure Access
                        </div>

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Fleet Management
                        </div>

                        <div>
                            <i class="bi bi-check-circle-fill"></i>
                            Maintenance Tracking
                        </div>

                    </div>

                </div>


                <!-- Hero Visual -->

                <div class="col-lg-6">

                    <div class="hero-visual">

                        <div class="floating-card floating-card-top">

                            <div class="floating-icon">
                                <i class="bi bi-car-front-fill"></i>
                            </div>

                            <div>
                                <small>Fleet Vehicles</small>
                                <strong>Managed</strong>
                            </div>

                        </div>


                        <div class="dashboard-preview">

                            <div class="preview-header">

                                <div>
                                    <span class="preview-dot"></span>
                                    <span class="preview-dot"></span>
                                    <span class="preview-dot"></span>
                                </div>

                                <span>FleetCare Pro</span>

                            </div>


                            <div class="preview-content">

                                <div class="preview-title">
                                    Fleet Overview
                                </div>

                                <div class="preview-stats">

                                    <div class="preview-stat">
                                        <i class="bi bi-car-front"></i>
                                        <strong>Vehicles</strong>
                                        <span>Fleet Management</span>
                                    </div>

                                    <div class="preview-stat">
                                        <i class="bi bi-wrench-adjustable"></i>
                                        <strong>Maintenance</strong>
                                        <span>Service Tracking</span>
                                    </div>

                                    <div class="preview-stat">
                                        <i class="bi bi-building"></i>
                                        <strong>Centers</strong>
                                        <span>Service Providers</span>
                                    </div>

                                    <div class="preview-stat">
                                        <i class="bi bi-bar-chart-line"></i>
                                        <strong>Analytics</strong>
                                        <span>Fleet Insights</span>
                                    </div>

                                </div>


                                <div class="preview-chart">

                                    <div class="chart-label">
                                        Maintenance Overview
                                    </div>

                                    <div class="chart-bars">

                                        <span style="height:45%"></span>
                                        <span style="height:65%"></span>
                                        <span style="height:40%"></span>
                                        <span style="height:80%"></span>
                                        <span style="height:60%"></span>
                                        <span style="height:90%"></span>
                                        <span style="height:72%"></span>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <div class="floating-card floating-card-bottom">

                            <div class="status-icon">
                                <i class="bi bi-check-lg"></i>
                            </div>

                            <div>
                                <small>Maintenance</small>
                                <strong>Under Control</strong>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ========================= FEATURES ========================= -->

    <section id="features" class="features-section">

        <div class="container">

            <div class="section-heading text-center">

                <span class="section-label">
                    POWERFUL FEATURES
                </span>

                <h2>
                    Everything Your Fleet Needs
                </h2>

                <p>
                    Manage your entire vehicle maintenance workflow
                    through one centralized system.
                </p>

            </div>


            <div class="row g-4">

                <!-- Vehicle Management -->

                <div class="col-md-6 col-lg-4">

                    <div class="feature-card">

                        <div class="feature-icon blue">
                            <i class="bi bi-car-front-fill"></i>
                        </div>

                        <h4>Vehicle Management</h4>

                        <p>
                            Manage vehicle information, mileage,
                            status, assignments, and maintenance history.
                        </p>

                    </div>

                </div>


                <!-- Maintenance -->

                <div class="col-md-6 col-lg-4">

                    <div class="feature-card">

                        <div class="feature-icon orange">
                            <i class="bi bi-wrench-adjustable"></i>
                        </div>

                        <h4>Maintenance Tracking</h4>

                        <p>
                            Track service records, maintenance costs,
                            service items, and maintenance statuses.
                        </p>

                    </div>

                </div>


                <!-- Service Centers -->

                <div class="col-md-6 col-lg-4">

                    <div class="feature-card">

                        <div class="feature-icon green">
                            <i class="bi bi-building"></i>
                        </div>

                        <h4>Service Centers</h4>

                        <p>
                            Organize service providers and connect
                            them with the services your fleet needs.
                        </p>

                    </div>

                </div>


                <!-- Service Records -->

                <div class="col-md-6 col-lg-4">

                    <div class="feature-card">

                        <div class="feature-icon purple">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>

                        <h4>Service Records</h4>

                        <p>
                            Create detailed maintenance transactions
                            with service categories, costs, notes,
                            and invoice documents.
                        </p>

                    </div>

                </div>


                <!-- Security -->

                <div class="col-md-6 col-lg-4">

                    <div class="feature-card">

                        <div class="feature-icon red">
                            <i class="bi bi-shield-lock"></i>
                        </div>

                        <h4>Secure Access</h4>

                        <p>
                            Role-based access ensures every user
                            can access only the features they need.
                        </p>

                    </div>

                </div>


                <!-- Dashboard -->

                <div class="col-md-6 col-lg-4">

                    <div class="feature-card">

                        <div class="feature-icon cyan">
                            <i class="bi bi-speedometer2"></i>
                        </div>

                        <h4>Smart Dashboard</h4>

                        <p>
                            Get a clear overview of fleet vehicles,
                            maintenance activities, and service operations.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ========================= HOW IT WORKS ========================= -->

    <section class="how-section">

        <div class="container">

            <div class="section-heading text-center">

                <span class="section-label">
                    HOW IT WORKS
                </span>

                <h2>
                    Manage Your Fleet in Three Steps
                </h2>

                <p>
                    A simple workflow designed to keep your
                    fleet operations organized.
                </p>

            </div>


            <div class="row g-4">

                <div class="col-md-4">

                    <div class="step-card">

                        <div class="step-number">
                            01
                        </div>

                        <div class="step-icon">
                            <i class="bi bi-person-check"></i>
                        </div>

                        <h4>Login Securely</h4>

                        <p>
                            Access FleetCare Pro using your authorized
                            account and role.
                        </p>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="step-card">

                        <div class="step-number">
                            02
                        </div>

                        <div class="step-icon">
                            <i class="bi bi-speedometer2"></i>
                        </div>

                        <h4>Manage Your Fleet</h4>

                        <p>
                            Manage vehicles, service centers,
                            categories, and maintenance records.
                        </p>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="step-card">

                        <div class="step-number">
                            03
                        </div>

                        <div class="step-icon">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>

                        <h4>Track & Improve</h4>

                        <p>
                            Monitor maintenance activities,
                            service costs, and fleet performance.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ========================= CTA ========================= -->

    <section class="cta-section">

        <div class="container">

            <div class="cta-card">

                <div>

                    <span class="section-label">
                        GET STARTED
                    </span>

                    <h2>
                        Ready to Take Control of Your Fleet?
                    </h2>

                    <p>
                        Start managing your vehicles and maintenance
                        operations with FleetCare Pro.
                    </p>

                </div>

                <div>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-light btn-lg">
                        Get Started
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>

        </div>

    </section>

</div>
@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}