@model FleetCarePro.Web.ViewModels.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    // Derived, read-only stats for the status ring/progress bars.
    // No new model properties needed — just safe percentages of the existing counts.
    var totalRecords = Model.TotalServiceRecords;

    double PercentOf(int value) => totalRecords > 0 ? Math.Round((double)value / totalRecords * 100, 1) : 0;

    var pendingPct = PercentOf(Model.PendingServices);
    var approvedPct = PercentOf(Model.ApprovedServices);
    var completedPct = PercentOf(Model.CompletedServices);
    var cancelledPct = PercentOf(Model.CancelledServices);
}

<div class="dashboard-page">

    <div class="dashboard-header mb-4">

        <div>
            <span class="dashboard-eyebrow">
                <i class="bi bi-lightning-charge-fill"></i>
                FLEETCARE PRO
            </span>

            <h1 class="dashboard-title">
                Welcome back <span class="wave">👋</span>
            </h1>

            <p class="dashboard-subtitle">
                Here's what's happening with your fleet today.
            </p>
        </div>

        <div class="dashboard-date">
            <i class="bi bi-calendar3"></i>
            @DateTime.Today.ToString("dddd, dd MMMM yyyy")
        </div>

    </div>

    @if (User.IsInRole("Admin"))
    {
        <!-- Main Statistics -->

        <div class="row g-4 mb-4">

            <!-- Vehicles -->

            <div class="col-md-6 col-xl-3">
                <div class="dashboard-stat-card vehicles-card">

                    <div class="stat-top">
                        <div>
                            <span class="stat-label">
                                Total Vehicles
                            </span>

                            <h2 class="stat-number">
                                @Model.TotalVehicles
                            </h2>
                        </div>

                        <div class="stat-icon">
                            <i class="bi bi-car-front-fill"></i>
                        </div>
                    </div>

                    <a asp-controller="Vehicle"
                       asp-action="Index"
                       class="stat-link">
                        View Vehicles
                        <i class="bi bi-arrow-right"></i>
                    </a>


                </div>

            </div>


            <!-- Service Centers -->

            <div class="col-md-6 col-xl-3">
                <div class="dashboard-stat-card centers-card">

                    <div class="stat-top">
                        <div>
                            <span class="stat-label">
                                Service Centers
                            </span>

                            <h2 class="stat-number">
                                @Model.TotalServiceCenters
                            </h2>
                        </div>

                        <div class="stat-icon">
                            <i class="bi bi-building"></i>
                        </div>
                    </div>

                    <a asp-controller="ServiceCenter"
                       asp-action="Index"
                       class="stat-link">
                        View Centers
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>
            </div>


            <!-- Categories -->

            <div class="col-md-6 col-xl-3">
                <div class="dashboard-stat-card categories-card">

                    <div class="stat-top">
                        <div>
                            <span class="stat-label">
                                Service Categories
                            </span>

                            <h2 class="stat-number">
                                @Model.TotalServiceCategories
                            </h2>
                        </div>

                        <div class="stat-icon">
                            <i class="bi bi-tags-fill"></i>
                        </div>
                    </div>

                    <a asp-controller="ServiceCategory"
                       asp-action="Index"
                       class="stat-link">
                        View Categories
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>
            </div>


            <!-- Users -->

            <div class="col-md-6 col-xl-3">
                <div class="dashboard-stat-card users-card">

                    <div class="stat-top">
                        <div>
                            <span class="stat-label">
                                Total Users
                            </span>

                            <h2 class="stat-number">
                                @Model.TotalUsers
                            </h2>
                        </div>

                        <div class="stat-icon">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>

                    <a asp-controller="Admin"
                       asp-action="Users"
                       class="stat-link">
                        Manage Users
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>
            </div>

        </div>



        <!-- Service Overview -->
        <!-- Service Overview -->

        <div class="dashboard-section-title">
            <div>
                <h4>Service Overview</h4>
                <p>Current maintenance status across the fleet</p>
            </div>

            <a asp-controller="ServiceRecord"
               asp-action="Index"
               class="view-all-link">
                View all records
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>


        <div class="service-overview-chart mb-4">

            @{
                var totalServices = Model.PendingServices
                + Model.ApprovedServices
                + Model.CompletedServices
                + Model.CancelledServices;

                var pendingPercent = totalServices > 0
                ? (double)Model.PendingServices / totalServices * 100
                : 0;

                var approvedPercent = totalServices > 0
                ? (double)Model.ApprovedServices / totalServices * 100
                : 0;

                var completedPercent = totalServices > 0
                ? (double)Model.CompletedServices / totalServices * 100
                : 0;

                var cancelledPercent = totalServices > 0
                ? (double)Model.CancelledServices / totalServices * 100
                : 0;
            }


            <!-- Donut Chart -->

            <div class="service-donut-wrapper">

                <div class="service-donut"
                     style="
                    --pending:@pendingPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;
                    --approved:@approvedPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;
                    --completed:@completedPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;
                    --cancelled:@cancelledPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;

                    --pending-end:var(--pending);
                    --approved-end:calc(var(--pending) + var(--approved));
                    --completed-end:calc(var(--pending) + var(--approved) + var(--completed));
                 ">

                    <div class="donut-center">
                        <strong>@totalServices</strong>
                        <span>Total Services</span>
                    </div>

                </div>

            </div>


            <!-- Legend -->

            <div class="service-status-list">

                <!-- Pending -->

                <div class="service-status-item">

                    <div class="service-status-info">
                        <span class="status-dot pending-dot"></span>

                        <div>
                            <span class="service-status-name">
                                Pending
                            </span>

                            <small>
                                Awaiting review
                            </small>
                        </div>
                    </div>

                    <div class="service-status-value">
                        <strong>@Model.PendingServices</strong>
                        <span>@pendingPercent.ToString("0.#")%</span>
                    </div>

                </div>


                <!-- Approved -->

                <div class="service-status-item">

                    <div class="service-status-info">
                        <span class="status-dot approved-dot"></span>

                        <div>
                            <span class="service-status-name">
                                Approved
                            </span>

                            <small>
                                Ready for service
                            </small>
                        </div>
                    </div>

                    <div class="service-status-value">
                        <strong>@Model.ApprovedServices</strong>
                        <span>@approvedPercent.ToString("0.#")%</span>
                    </div>

                </div>


                <!-- Completed -->

                <div class="service-status-item">

                    <div class="service-status-info">
                        <span class="status-dot completed-dot"></span>

                        <div>
                            <span class="service-status-name">
                                Completed
                            </span>

                            <small>
                                Successfully completed
                            </small>
                        </div>
                    </div>

                    <div class="service-status-value">
                        <strong>@Model.CompletedServices</strong>
                        <span>@completedPercent.ToString("0.#")%</span>
                    </div>

                </div>


                <!-- Cancelled -->

                <div class="service-status-item">

                    <div class="service-status-info">
                        <span class="status-dot cancelled-dot"></span>

                        <div>
                            <span class="service-status-name">
                                Cancelled
                            </span>

                            <small>
                                Cancelled services
                            </small>
                        </div>
                    </div>

                    <div class="service-status-value">
                        <strong>@Model.CancelledServices</strong>
                        <span>@cancelledPercent.ToString("0.#")%</span>
                    </div>

                </div>

            </div>

        </div>
        <div class="row g-4 mb-4">

            <!-- Overdue Maintenance -->
            <div class="col-md-6">

                @await Component.InvokeAsync("OverdueMaintenance")

            </div>


            <!-- Fleet Cost Summary -->
            <div class="col-md-6">

                @await Component.InvokeAsync("FleetCostSummary")

            </div>

        </div>

        <!-- Total Records -->

        <div class="total-record-card">

            <div class="total-record-icon">
                <i class="bi bi-wrench-adjustable"></i>
            </div>

            <div class="total-record-content">

                <span>
                    Total Service Records
                </span>

                <strong>
                    @Model.TotalServiceRecords
                </strong>

                <small>
                    Maintenance transactions recorded in the system
                </small>

            </div>

            <a asp-controller="ServiceRecord"
               asp-action="Index"
               class="total-record-btn">
                View All Records
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>
    }

    @if (User.IsInRole("FleetManager"))
    {
        <!-- Main Statistics -->

        <div class="row g-4 mb-4">

            <div class="col-md-6 col-xl-4">
                <div class="dashboard-stat-card vehicles-card">

                    <div class="stat-top">
                        <div>
                            <span class="stat-label">
                                Fleet Vehicles
                            </span>

                            <h2 class="stat-number">
                                @Model.TotalVehicles
                            </h2>
                        </div>

                        <div class="stat-icon">
                            <i class="bi bi-car-front-fill"></i>
                        </div>
                    </div>

                    <a asp-controller="Vehicle"
                       asp-action="Index"
                       class="stat-link">
                        Manage Vehicles
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>
            </div>


            <div class="col-md-6 col-xl-4">
                <div class="dashboard-stat-card centers-card">

                    <div class="stat-top">
                        <div>
                            <span class="stat-label">
                                Service Centers
                            </span>

                            <h2 class="stat-number">
                                @Model.TotalServiceCenters
                            </h2>
                        </div>

                        <div class="stat-icon">
                            <i class="bi bi-building"></i>
                        </div>
                    </div>

                    <a asp-controller="ServiceCenter"
                       asp-action="Index"
                       class="stat-link">
                        View Centers
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>
            </div>


            <div class="col-md-6 col-xl-4">
                <div class="dashboard-stat-card categories-card">

                    <div class="stat-top">
                        <div>
                            <span class="stat-label">
                                Service Categories
                            </span>

                            <h2 class="stat-number">
                                @Model.TotalServiceCategories
                            </h2>
                        </div>

                        <div class="stat-icon">
                            <i class="bi bi-tags-fill"></i>
                        </div>
                    </div>

                    <a asp-controller="ServiceCategory"
                       asp-action="Index"
                       class="stat-link">
                        View Categories
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>
            </div>

        </div>


        <!-- Service Overview -->

        <div class="dashboard-section-title">
            <div>
                <h4>Service Overview</h4>
                <p>Current maintenance status across the fleet</p>
            </div>

            <a asp-controller="ServiceRecord"
               asp-action="Index"
               class="view-all-link">
                View all records
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>


        <div class="service-overview-chart mb-4">

            @{
                var totalServices = Model.PendingServices
                + Model.ApprovedServices
                + Model.CompletedServices
                + Model.CancelledServices;

                var pendingPercent = totalServices > 0
                ? (double)Model.PendingServices / totalServices * 100
                : 0;

                var approvedPercent = totalServices > 0
                ? (double)Model.ApprovedServices / totalServices * 100
                : 0;

                var completedPercent = totalServices > 0
                ? (double)Model.CompletedServices / totalServices * 100
                : 0;

                var cancelledPercent = totalServices > 0
                ? (double)Model.CancelledServices / totalServices * 100
                : 0;
            }


            <!-- Donut Chart -->

            <div class="service-donut-wrapper">

                <div class="service-donut"
                     style="
                        --pending:@pendingPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;
                        --approved:@approvedPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;
                        --completed:@completedPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;
                        --cancelled:@cancelledPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;

                        --pending-end:var(--pending);
                        --approved-end:calc(var(--pending) + var(--approved));
                        --completed-end:calc(var(--pending) + var(--approved) + var(--completed));
                     ">

                    <div class="donut-center">
                        <strong>@totalServices</strong>
                        <span>Total Services</span>
                    </div>

                </div>

            </div>


            <!-- Legend -->

            <div class="service-status-list">

                <!-- Pending -->

                <div class="service-status-item">

                    <div class="service-status-info">
                        <span class="status-dot pending-dot"></span>

                        <div>
                            <span class="service-status-name">
                                Pending
                            </span>

                            <small>
                                Awaiting review
                            </small>
                        </div>
                    </div>

                    <div class="service-status-value">
                        <strong>@Model.PendingServices</strong>
                        <span>@pendingPercent.ToString("0.#")%</span>
                    </div>

                </div>


                <!-- Approved -->

                <div class="service-status-item">

                    <div class="service-status-info">
                        <span class="status-dot approved-dot"></span>

                        <div>
                            <span class="service-status-name">
                                Approved
                            </span>

                            <small>
                                Ready for service
                            </small>
                        </div>
                    </div>

                    <div class="service-status-value">
                        <strong>@Model.ApprovedServices</strong>
                        <span>@approvedPercent.ToString("0.#")%</span>
                    </div>

                </div>


                <!-- Completed -->

                <div class="service-status-item">

                    <div class="service-status-info">
                        <span class="status-dot completed-dot"></span>

                        <div>
                            <span class="service-status-name">
                                Completed
                            </span>

                            <small>
                                Successfully completed
                            </small>
                        </div>
                    </div>

                    <div class="service-status-value">
                        <strong>@Model.CompletedServices</strong>
                        <span>@completedPercent.ToString("0.#")%</span>
                    </div>

                </div>


                <!-- Cancelled -->

                <div class="service-status-item">

                    <div class="service-status-info">
                        <span class="status-dot cancelled-dot"></span>

                        <div>
                            <span class="service-status-name">
                                Cancelled
                            </span>

                            <small>
                                Cancelled services
                            </small>
                        </div>
                    </div>

                    <div class="service-status-value">
                        <strong>@Model.CancelledServices</strong>
                        <span>@cancelledPercent.ToString("0.#")%</span>
                    </div>

                </div>

            </div>

        </div>
        <div class="row g-4 mb-4">

            <!-- Overdue Maintenance -->
            <div class="col-md-6">

                @await Component.InvokeAsync("OverdueMaintenance")

            </div>


            <!-- Fleet Cost Summary -->
            <div class="col-md-6">

                @await Component.InvokeAsync("FleetCostSummary")

            </div>

        </div>


        <!-- Total Records -->

        <div class="total-record-card">

            <div class="total-record-icon">
                <i class="bi bi-wrench-adjustable"></i>
            </div>

            <div class="total-record-content">

                <span>
                    Total Service Records
                </span>

                <strong>
                    @Model.TotalServiceRecords
                </strong>

                <small>
                    Maintenance transactions recorded in the system
                </small>

            </div>

            <a asp-controller="ServiceRecord"
               asp-action="Index"
               class="total-record-btn">
                View All Records
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>
    }


    @if (User.IsInRole("Driver"))
    {
        <div class="row justify-content-center">

            <div class="col-md-6 col-xl-4">

                <div class="driver-card">

                    <div class="driver-card-icon">
                        <i class="bi bi-car-front-fill"></i>
                    </div>

                    <span>
                        My Assigned Vehicles
                    </span>

                    <strong>
                        @Model.AssignedVehicles
                    </strong>

                    <p>
                        Vehicles currently assigned to you.
                    </p>

                    <a asp-controller="Vehicle"
                       asp-action="Index"
                       class="driver-card-btn">
                        View My Vehicles
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>

        </div>
    }

</div>
