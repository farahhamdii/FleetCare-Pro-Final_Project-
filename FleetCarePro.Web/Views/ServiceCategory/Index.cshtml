@model IEnumerable<FleetCarePro.Web.ViewModels.ServiceCategory.ServiceCategoryListViewModel>

@{
    ViewData["Title"] = "Service Categories";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">
                <i class="bi bi-tags me-2"></i>Service Categories
            </h2>
            <p class="text-muted">
                Manage vehicle service categories and maintenance intervals.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Category
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            No service categories found.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Category Name</th>
                                <th>Description</th>
                                <th>Recommended Interval</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td>@category.Id</td>

                                    <td>
                                        <strong>
                                            @category.CategoryName
                                        </strong>
                                    </td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(category.Description))
                                        {
                                            <span class="text-muted">
                                                No description
                                            </span>
                                        }
                                        else
                                        {
                                            @category.Description
                                        }
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @category.RecommendedIntervalMonths months
                                        </span>
                                    </td>

                                    <td class="text-center">

                                        <a asp-action="Details"
                                           asp-route-id="@category.Id"
                                           class="btn btn-sm btn-outline-info me-1">Details
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@category.Id"
                                           class="btn btn-sm btn-outline-warning me-1">
                                            <i class="bi bi-pencil"></i>Edit
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@category.Id"
                                              method="post"
                                              class="d-inline" 
                                              onsubmit="return confirm('Are you sure you want to delete this service category?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>

                                        </form>

                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    }
</div>