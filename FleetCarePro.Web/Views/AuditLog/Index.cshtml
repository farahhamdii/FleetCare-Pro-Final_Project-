@model IEnumerable<FleetCarePro.Web.ViewModels.AuditLog.AuditLogViewModel>

@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">

                <div class="page-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <h2 class="fw-bold mb-0">
                    Audit Logs
                </h2>

            </div>

            <p class="text-muted mb-0">
                Track user actions and system activities.
            </p>
        </div>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <h5 class="fw-bold mb-1">
                System Activity
            </h5>

            <small class="text-muted">
                User actions recorded by FleetCare Pro
            </small>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>

                            <th class="ps-4">
                                User
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Action
                            </th>

                            <th>
                                Details
                            </th>

                            <th>
                                Date & Time
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="5"
                                    class="text-center py-5">

                                    <i class="bi bi-shield-x fs-1 text-muted"></i>

                                    <h5 class="mt-3">
                                        No Audit Logs Found
                                    </h5>

                                    <p class="text-muted mb-0">
                                        No system activities have been recorded yet.
                                    </p>

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var log in Model)
                            {
                                <tr>

                                    <td class="ps-4">

                                        <div class="fw-semibold">

                                            <i class="bi bi-person-circle me-1 text-primary"></i>

                                            @log.UserName

                                        </div>

                                    </td>


                                    <td>
                                        @log.UserEmail
                                    </td>


                                    <td>

                                        <span class="badge bg-primary">
                                            @log.Action
                                        </span>

                                    </td>


                                    <td>

                                        @if (!string.IsNullOrEmpty(log.Details))
                                        {
                                            @log.Details
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <span class="fw-semibold">
                                            @log.Timestamp.ToLocalTime().ToString("dd/MM/yyyy")
                                        </span>

                                        <br />

                                        <small class="text-muted">
                                            @log.Timestamp.ToLocalTime().ToString("hh:mm tt")
                                        </small>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<style>

    .page-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: rgba(37, 99, 235, 0.1);
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .table > :not(caption) > * > * {
        padding-top: 14px;
        padding-bottom: 14px;
    }

    .table-hover tbody tr {
        transition: background-color 0.15s ease;
    }

        .table-hover tbody tr:hover {
            background-color: #f8fafc;
        }

</style>