@model FleetCarePro.Web.ViewModels.ServiceCenter.ServiceCenterDetailsViewModel

@{
    ViewData["Title"] = "Service Center Details";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow">

                <div class="card-header">
                    <h3 class="mb-0">
                        <i class="bi bi-building me-2"></i>
                        Service Center Details
                    </h3>
                </div>

                <div class="card-body">

                    <dl class="row">

                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">
                            @Model.Name
                        </dd>

                        <dt class="col-sm-4">Phone Number</dt>
                        <dd class="col-sm-8">
                            @Model.PhoneNumber
                        </dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">
                            @Model.Email
                        </dd>

                        <dt class="col-sm-4">Address</dt>
                        <dd class="col-sm-8">
                            @Model.Address
                        </dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">

                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactive
                                </span>
                            }

                        </dd>

                    </dl>


                    <!-- SERVICE CATEGORIES -->

                    <hr />

                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-tools me-2"></i>
                        Available Services
                    </h5>

                    @if (Model.ServiceCategories.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">

                            @foreach (var category in Model.ServiceCategories)
                            {
                                <span class="badge bg-primary fs-6">
                                    @category
                                </span>
                            }

                        </div>
                    }
                    else
                    {
                        <p class="text-muted">
                            No service categories assigned to this center.
                        </p>
                    }


                    <div class="mt-4">

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-warning">

                            <i class="bi bi-pencil me-1"></i>
                            Edit

                        </a>

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            <i class="bi bi-arrow-left me-1"></i>
                            Back

                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>