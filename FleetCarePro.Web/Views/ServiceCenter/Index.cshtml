
@model IEnumerable<FleetCarePro.Web.ViewModels.ServiceCenter.ServiceCenterListViewModel>

@{
    ViewData["Title"] = "Service Centers";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">
                <i class="bi bi-building me-2"></i>Service Centers
            </h2>
            <p class="text-muted mb-0">
                Manage all service centers in the system.
            </p>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("FleetManager"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>
                Add Service Center
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <i class="bi bi-building display-4 text-muted"></i>

                <h5 class="mt-3">
                    No service centers found
                </h5>

                <p class="text-muted">
                    There are no service centers available yet.
                </p>

                @if (User.IsInRole("Admin") || User.IsInRole("FleetManager"))
                {
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>
                        Add First Service Center
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">
                            <tr>
                                <th>Name</th>
                                <th>Phone</th>
                                <th>Email</th>
                                <th>Address</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var center in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @center.Name
                                    </td>

                                    <td>
                                        @center.PhoneNumber
                                    </td>

                                    <td>
                                        @center.Email
                                    </td>

                                    <td>
                                        @center.Address
                                    </td>

                                    <td>
                                        @if (center.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">

                                        <a asp-action="Details"
                                           asp-route-id="@center.Id"
                                           class="btn btn-sm btn-info text-white">
                                            Details
                                        </a>

                                        @if (User.IsInRole("Admin") || User.IsInRole("FleetManager"))
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@center.Id"
                                               class="btn btn-sm btn-warning text-dark">
                                                Edit
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@center.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this service center?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    Delete
                                                </button>

                                            </form>
                                        }

                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    }
</div>

