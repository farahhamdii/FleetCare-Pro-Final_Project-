
@model IEnumerable<FleetCarePro.Domain.Entities.ApplicationUser>

@{
    ViewData["Title"] = "User Management";
    var userRoles = ViewBag.UserRoles as Dictionary<string, string>;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people-fill me-2"></i>User Management
            </h2>
            <p class="text-muted mb-0">
                Manage system users and their roles.
            </p>
        </div>

        <a asp-action="CreateUser" class="btn btn-primary">
            <i class="bi bi-person-plus-fill me-1"></i>
            Add User
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-people display-4"></i>
                    <p class="mt-3 mb-0">No users found.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Full Name</th>
                                <th>Employee ID</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in Model)
                            {
                                var role = userRoles != null &&
                                userRoles.ContainsKey(user.Id)
                                ? userRoles[user.Id]
                                : "No Role";

                                <tr>
                                    <td class="fw-semibold">
                                        @user.FullName
                                    </td>

                                    <td>
                                        @user.EmployeeId
                                    </td>

                                    <td>
                                        @user.Email
                                    </td>

                                    <td>
                                        @if (role == "Admin")
                                        {
                                            <span class="badge bg-danger">
                                                Admin
                                            </span>
                                        }
                                        else if (role == "FleetManager")
                                        {
                                            <span class="badge bg-primary">
                                                Fleet Manager
                                            </span>
                                        }
                                        else if (role == "Driver")
                                        {
                                            <span class="badge bg-success">
                                                Driver
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                No Role
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <a asp-action="EditUser"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-warning"> Edit
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="DeleteUser"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-danger">Delete
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>

