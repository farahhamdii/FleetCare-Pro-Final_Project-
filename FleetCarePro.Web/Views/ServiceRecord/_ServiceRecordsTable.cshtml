@model IEnumerable<FleetCarePro.Web.ViewModels.ServiceRecord.ServiceRecordListViewModel>

@if (!Model.Any())
{
    <div class="text-center py-5">

        <i class="bi bi-inbox fs-1 text-muted"></i>

        <h5 class="mt-3">
            No Service Records Found
        </h5>

        <p class="text-muted mb-0">
            No records match the selected status.
        </p>

    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-dark">

                <tr>
                    <th>Vehicle</th>
                    <th>Service Center</th>
                    <th>Service Date</th>
                    <th>Mileage</th>
                    <th>Total Cost</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var record in Model)
                {
                    <tr>

                        <td>
                            <strong>
                                @record.VehicleLicensePlate
                            </strong>
                        </td>

                        <td>
                            @record.ServiceCenterName
                        </td>

                        <td>
                            @record.ServiceDate.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @record.CurrentMileage.ToString("N0") KM
                        </td>

                        <td>
                            <strong>
                                @record.TotalCost.ToString("N2")
                            </strong>
                        </td>

                        <td>

                            @if (record.Status == FleetCarePro.Domain.Enums.ServiceRecordStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }
                            else if (record.Status == FleetCarePro.Domain.Enums.ServiceRecordStatus.Approved)
                            {
                                <span class="badge bg-primary">
                                    Approved
                                </span>
                            }
                            else if (record.Status == FleetCarePro.Domain.Enums.ServiceRecordStatus.Completed)
                            {
                                <span class="badge bg-success">
                                    Completed
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Cancelled
                                </span>
                            }

                        </td>

                        <td class="text-center">

                            <a asp-action="Details"
                               asp-route-id="@record.Id"
                               class="btn btn-sm btn-info">
                                Details
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@record.Id"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@record.Id"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this service record?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-danger">
                                    Delete
                                </button>

                            </form>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}