
@model IEnumerable<FleetCarePro.Web.ViewModels.ServiceRecord.ServiceRecordListViewModel>

@{
    ViewData["Title"] = "Service Records";
}

<div class="container-fluid px-4 py-4">

    <!-- ================= HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <div class="page-icon">
                    <i class="bi bi-wrench-adjustable"></i>
                </div>

                <h2 class="fw-bold mb-0">
                    Service Records
                </h2>
            </div>

            <p class="text-muted mb-0">
                Manage and monitor vehicle maintenance records.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary px-4">

            <i class="bi bi-plus-lg me-2"></i>
            Add Service Record

        </a>

    </div>


    <!-- ================= SUCCESS MESSAGE ================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ================= FILTER ================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Filter by Status
                    </label>

                    <select name="status"
                            class="form-select">

                        <option value="">
                            All Service Records
                        </option>

                        @if (ViewBag.StatusFilter?.ToString() == "Pending")
                        {
                            <option value="Pending" selected>
                                Pending
                            </option>
                        }
                        else
                        {
                            <option value="Pending">
                                Pending
                            </option>
                        }

                        @if (ViewBag.StatusFilter?.ToString() == "Approved")
                        {
                            <option value="Approved" selected>
                                Approved
                            </option>
                        }
                        else
                        {
                            <option value="Approved">
                                Approved
                            </option>
                        }

                        @if (ViewBag.StatusFilter?.ToString() == "Completed")
                        {
                            <option value="Completed" selected>
                                Completed
                            </option>
                        }
                        else
                        {
                            <option value="Completed">
                                Completed
                            </option>
                        }

                        @if (ViewBag.StatusFilter?.ToString() == "Cancelled")
                        {
                            <option value="Cancelled" selected>
                                Cancelled
                            </option>
                        }
                        else
                        {
                            <option value="Cancelled">
                                Cancelled
                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-auto">

                    <button type="submit"
                            class="btn btn-dark">

                        <i class="bi bi-funnel me-2"></i>
                        Apply Filter

                    </button>

                </div>

                <div class="col-md-auto">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-counterclockwise me-2"></i>
                        Clear

                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- ================= EMPTY STATE ================= -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <div class="empty-icon mb-3">
                    <i class="bi bi-wrench-adjustable"></i>
                </div>

                <h5 class="fw-bold">
                    No Service Records Found
                </h5>

                <p class="text-muted">
                    There are no maintenance records matching your current filter.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-lg me-2"></i>
                    Add Service Record

                </a>

            </div>

        </div>
    }
    else
    {
        <!-- ================= TABLE ================= -->

        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white border-0 py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h5 class="fw-bold mb-1">
                            Maintenance Records
                        </h5>

                        <small class="text-muted">
                            Showing service records for your fleet
                        </small>
                    </div>

                    @if (!string.IsNullOrEmpty(ViewBag.StatusFilter))
                    {
                        <span class="badge bg-light text-dark border px-3 py-2">

                            <i class="bi bi-funnel me-1"></i>

                            @ViewBag.StatusFilter

                        </span>
                    }

                </div>

            </div>


            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">

                            <tr>

                                <th class="ps-4">
                                    Vehicle
                                </th>

                                <th>
                                    Service Center
                                </th>

                                <th>
                                    Service Date
                                </th>

                                <th>
                                    Mileage
                                </th>

                                <th>
                                    Total Cost
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-center pe-4">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var record in Model)
                            {
                                <tr>

                                    <!-- Vehicle -->

                                    <td class="ps-4">

                                        <div class="fw-semibold">
                                            <i class="bi bi-car-front me-1 text-primary"></i>
                                            @record.VehicleLicensePlate
                                        </div>

                                    </td>


                                    <!-- Service Center -->

                                    <td>

                                        <span class="text-muted">
                                            <i class="bi bi-building me-1"></i>
                                            @record.ServiceCenterName
                                        </span>

                                    </td>


                                    <!-- Date -->

                                    <td>

                                        <span>
                                            @record.ServiceDate.ToString("dd/MM/yyyy")
                                        </span>

                                    </td>


                                    <!-- Mileage -->

                                    <td>

                                        <span class="fw-semibold">
                                            @record.CurrentMileage.ToString("N0")
                                        </span>

                                        <small class="text-muted">
                                            KM
                                        </small>

                                    </td>


                                    <!-- Cost -->

                                    <td>

                                        <span class="fw-bold">
                                            @record.TotalCost.ToString("N2")
                                        </span>

                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @switch (record.Status)
                                        {
                                            case FleetCarePro.Domain.Enums.ServiceRecordStatus.Pending:

                                                <span class="badge status-badge pending">
                                                    <i class="bi bi-clock me-1"></i>
                                                    Pending
                                                </span>

                                                break;

                                            case FleetCarePro.Domain.Enums.ServiceRecordStatus.Approved:

                                                <span class="badge status-badge approved">
                                                    <i class="bi bi-check-circle me-1"></i>
                                                    Approved
                                                </span>

                                                break;

                                            case FleetCarePro.Domain.Enums.ServiceRecordStatus.Completed:

                                                <span class="badge status-badge completed">
                                                    <i class="bi bi-check2-all me-1"></i>
                                                    Completed
                                                </span>

                                                break;

                                            case FleetCarePro.Domain.Enums.ServiceRecordStatus.Cancelled:

                                                <span class="badge status-badge cancelled">
                                                    <i class="bi bi-x-circle me-1"></i>
                                                    Cancelled
                                                </span>

                                                break;
                                        }

                                    </td>


                                    <!-- Actions -->

                                    <td class="text-center pe-4">

                                        <div class="d-flex justify-content-center gap-1">

                                            <a asp-action="Details"
                                               asp-route-id="@record.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="View Details">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <a asp-action="Edit"
                                               asp-route-id="@record.Id"
                                               class="btn btn-sm btn-outline-warning"
                                               title="Edit">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <form asp-action="Delete"
                                                  asp-route-id="@record.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this service record?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- ================= PAGINATION ================= -->
            @if (ViewBag.TotalPages > 1)
            {
                <div class="card-footer bg-white border-0 py-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <small class="text-muted">
                            Page @ViewBag.CurrentPage
                            of @ViewBag.TotalPages
                        </small>


                        <nav>

                            <ul class="pagination mb-0">

                                <!-- Previous -->

                                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-status="@ViewBag.StatusFilter"
                                       asp-route-page="@(ViewBag.CurrentPage - 1)">

                                        <i class="bi bi-chevron-left"></i>
                                        Previous

                                    </a>

                                </li>


                                <!-- Pages -->
                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">

                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-status="@ViewBag.StatusFilter"
                                           asp-route-page="@i">

                                            @i

                                        </a>

                                    </li>
                                }


                                <!-- Next -->

                                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-status="@ViewBag.StatusFilter"
                                       asp-route-page="@(ViewBag.CurrentPage + 1)">

                                        Next
                                        <i class="bi bi-chevron-right"></i>

                                    </a>

                                </li>

                            </ul>

                        </nav>

                    </div>

                </div>
            }

        </div>
    }

</div>
<style>
.page-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
}

.empty-icon {
    width: 70px;
    height: 70px;
    margin: auto;
    border-radius: 50%;
    background: #f1f5f9;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
}

.status-badge {
    padding: 7px 11px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 600;
}

.status-badge.pending {
    background: #fff3cd;
    color: #856404;
}

.status-badge.approved {
    background: #dbeafe;
    color: #1d4ed8;
}

.status-badge.completed {
    background: #dcfce7;
    color: #166534;
}

.status-badge.cancelled {
    background: #fee2e2;
    color: #991b1b;
}

.table > :not(caption) > * > * {
    padding-top: 14px;
    padding-bottom: 14px;
}

.table-hover tbody tr {
    transition: background-color 0.15s ease;
}

.table-hover tbody tr:hover {
    background-color: #f8fafc;
}

.page-link {
    color: #374151;
}

.page-item.active .page-link {
    background-color: #2563eb;
    border-color: #2563eb;
}

.page-link:focus {
    box-shadow: none;
}

</style>