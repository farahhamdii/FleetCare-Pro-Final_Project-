@model FleetCarePro.Web.ViewModels.ServiceRecord.ServiceRecordDetailsViewModel

@{
    ViewData["Title"] = "Service Record Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">
                <i class="bi bi-wrench-adjustable me-2"></i>
                Service Record Details
            </h2>

            <p class="text-muted mb-0">
                View maintenance transaction details
            </p>
        </div>

        <div>
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                <i class="bi bi-pencil me-1"></i>
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back
            </a>
        </div>
    </div>


    <!-- ========================= -->
    <!-- SERVICE INFORMATION -->
    <!-- ========================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-info-circle me-2"></i>
                Service Information
            </h5>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <strong>Vehicle:</strong>
                    <div>
                        @Model.VehicleLicensePlate
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Service Center:</strong>
                    <div>
                        @Model.ServiceCenterName
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Service Date:</strong>
                    <div>
                        @Model.ServiceDate.ToString("dd/MM/yyyy")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Current Mileage:</strong>
                    <div>
                        @Model.CurrentMileage.ToString("N0") KM
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Total Cost:</strong>
                    <div>
                        @Model.TotalCost.ToString("N2")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Status:</strong>
                    <div>

                        @if (Model.Status == FleetCarePro.Domain.Enums.ServiceRecordStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }
                        else if (Model.Status == FleetCarePro.Domain.Enums.ServiceRecordStatus.Approved)
                        {
                            <span class="badge bg-primary">
                                Approved
                            </span>
                        }
                        else if (Model.Status == FleetCarePro.Domain.Enums.ServiceRecordStatus.Completed)
                        {
                            <span class="badge bg-success">
                                Completed
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Cancelled
                            </span>
                        }

                    </div>
                </div>

            </div>

        </div>
    </div>


    <!-- ========================= -->
    <!-- INVOICE -->
    <!-- ========================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-receipt me-2"></i>
                Invoice
            </h5>
        </div>

        <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(Model.InvoiceDocumentPath))
            {
                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <i class="bi bi-file-earmark-text fs-3 text-primary me-2"></i>

                        <span class="fw-semibold">
                            Invoice document
                        </span>
                    </div>

                    <div class="d-flex gap-2">

                        <a href="@Model.InvoiceDocumentPath"
                           target="_blank"
                           class="btn btn-primary">

                            <i class="bi bi-eye me-1"></i>
                            View Invoice

                        </a>

                        <a href="@Model.InvoiceDocumentPath"
                           download
                           class="btn btn-outline-secondary">

                            <i class="bi bi-download me-1"></i>
                            Download

                        </a>

                    </div>

                </div>
            }
            else
            {
                <div class="text-muted">

                    <i class="bi bi-file-earmark-x me-2"></i>

                    No invoice has been uploaded for this service record.

                </div>
            }

        </div>

    </div>


    <!-- ========================= -->
    <!-- NOTES -->
    <!-- ========================= -->
    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-sticky me-2"></i>
                    Notes
                </h5>
            </div>

            <div class="card-body">
                @Model.Notes
            </div>

        </div>
    }


    <!-- ========================= -->
    <!-- SERVICE LINE ITEMS -->
    <!-- ========================= -->

    <div class="card shadow-sm mb-5">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                <i class="bi bi-tools me-2"></i>
                Service Items
            </h5>

            <strong>
                Total:
                @Model.TotalCost.ToString("N2")
            </strong>

        </div>

        <div class="card-body">

            @if (!Model.ServiceLineItems.Any())
            {
                <div class="alert alert-info mb-0">
                    No service items found.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Cost</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.ServiceLineItems)
                            {
                                <tr>

                                    <td>
                                        @(item.CategoryName ?? "Unknown")
                                    </td>

                                    <td>
                                        @item.Description
                                    </td>

                                    <td>
                                        @item.Cost.ToString("N2")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>