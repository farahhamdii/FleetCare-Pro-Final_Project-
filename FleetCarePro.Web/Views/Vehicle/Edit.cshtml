@model FleetCarePro.Web.ViewModels.Vehicle.EditVehicleViewModel
@using FleetCarePro.Domain.Enums

@{
    ViewData["Title"] = "Edit Vehicle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-warning text-dark py-3">
                    <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Vehicle</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Vehicle" asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ExistingImageUrl" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-3">
                            <!-- VIN -->
                            <div class="col-md-6">
                                <label asp-for="VIN" class="form-label fw-semibold">VIN</label>
                                <input asp-for="VIN" class="form-control" />
                                <span asp-validation-for="VIN" class="text-danger small"></span>
                            </div>

                            <!-- License Plate -->
                            <div class="col-md-6">
                                <label asp-for="LicensePlate" class="form-label fw-semibold">License Plate</label>
                                <input asp-for="LicensePlate" class="form-control" />
                                <span asp-validation-for="LicensePlate" class="text-danger small"></span>
                            </div>

                            <!-- Make -->
                            <div class="col-md-6">
                                <label asp-for="Make" class="form-label fw-semibold">Make</label>
                                <input asp-for="Make" class="form-control" />
                                <span asp-validation-for="Make" class="text-danger small"></span>
                            </div>

                            <!-- Model -->
                            <div class="col-md-6">
                                <label asp-for="Model" class="form-label fw-semibold">Model</label>
                                <input asp-for="Model" class="form-control" />
                                <span asp-validation-for="Model" class="text-danger small"></span>
                            </div>

                            <!-- Year -->
                            <div class="col-md-4">
                                <label asp-for="Year" class="form-label fw-semibold">Year</label>
                                <input asp-for="Year" type="number" class="form-control" />
                                <span asp-validation-for="Year" class="text-danger small"></span>
                            </div>

                            <!-- Mileage -->
                            <div class="col-md-4">
                                <label asp-for="Mileage" class="form-label fw-semibold">Mileage (km)</label>
                                <input asp-for="Mileage" type="number" class="form-control" />
                                <span asp-validation-for="Mileage" class="text-danger small"></span>
                            </div>

                            <!-- Purchase Price -->
                            <div class="col-md-4">
                                <label asp-for="PurchasePrice" class="form-label fw-semibold">Purchase Price ($)</label>
                                <input asp-for="PurchasePrice" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
                            </div>

                            <!-- Status -->
                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold">Status</label>
                                <select asp-for="Status" asp-items="Html.GetEnumSelectList<VehicleStatus>()" class="form-select"></select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <!-- Driver Assignment -->
                            <div class="col-md-6">
                                <label asp-for="DriverId" class="form-label fw-semibold">Assign Driver</label>
                                <select asp-for="DriverId" asp-items="ViewBag.Drivers" class="form-select">
                                    <option value="">-- No Driver Assigned --</option>
                                </select>
                                <span asp-validation-for="DriverId" class="text-danger small"></span>
                            </div>

                            <!-- Existing & New Image -->
                            <div class="col-12">
                                <label class="form-label fw-semibold d-block">Vehicle Image</label>
                                @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                                {
                                    <div class="mb-2">
                                        <img src="@Model.ExistingImageUrl" alt="Current Image" class="img-thumbnail rounded" style="max-height: 120px;" />
                                        <small class="text-muted d-block mt-1">Current Photo</small>
                                    </div>
                                }
                                <input asp-for="VehicleImage" type="file" class="form-control" accept="image/*" />
                                <small class="text-muted">Leave empty if you don't want to change the image.</small>
                                <span asp-validation-for="VehicleImage" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="bi bi-check-circle me-1"></i> Update Vehicle
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}