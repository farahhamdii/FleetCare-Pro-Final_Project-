@model FleetCarePro.Web.ViewModels.Vehicle.VehicleListViewModel
@using FleetCarePro.Domain.Enums

<div class="col-md-4 col-sm-6 mb-4">
    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden position-relative">

        <!-- Status Badge -->
        <div class="position-absolute top-0 end-0 m-2">
            @switch (Model.Status)
            {
                case VehicleStatus.Active:
                    <span class="badge bg-success">Active</span>
                    break;
                case VehicleStatus.InService:
                    <span class="badge bg-warning text-dark">In Service</span>
                    break;
                case VehicleStatus.Decommissioned:
                    <span class="badge bg-danger">Decommissioned</span>
                    break;
                default:
                    <span class="badge bg-secondary">@Model.Status</span>
                    break;
            }
        </div>

        <!-- Vehicle Image -->
        @if (!string.IsNullOrEmpty(Model.VehicleImageURL))
        {
            <img src="@Model.VehicleImageURL" class="card-img-top object-fit-cover" alt="@Model.Make @Model.Model" style="height: 180px;">
        }
        else
        {
            <div class="card-img-top bg-light d-flex align-items-center justify-content-center text-muted" style="height: 180px;">
                <i class="bi bi-car-front display-4"></i>
            </div>
        }

        <!-- Card Body -->
        <div class="card-body d-flex flex-column">
            <h5 class="card-title text-primary fw-bold">
                @Model.Make @Model.Model <span class="text-muted fs-6">(@Model.Year)</span>
            </h5>

            <p class="card-text mb-1">
                <strong>License Plate:</strong> <span class="badge bg-light text-dark border">@Model.LicensePlate</span>
            </p>
            <p class="card-text mb-3">
                <small class="text-muted"><strong>VIN:</strong> @Model.VIN</small>
            </p>

            <!-- Actions Footer -->
            <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-eye"></i> Details
                </a>

                @if (User.IsInRole("Admin") || User.IsInRole("FleetManager"))
                {
                    <div class="btn-group">
                        <a asp-controller="Vehicle" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-warning">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@Model.Id">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>

                    <!-- Delete Confirmation Modal -->
                    <div class="modal fade" id="deleteModal-@Model.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header bg-danger text-white">
                                    <h5 class="modal-title">Confirm Delete</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-content-body p-3">
                                    <p>Are you sure you want to delete <strong>@Model.Make @Model.Model (@Model.LicensePlate)</strong>?</p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <form asp-controller="Vehicle" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>